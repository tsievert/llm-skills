# Starter .gitattributes. Attributes beat each machine's core.autocrlf (tested).
# After adding this to an existing project run:  git add --renormalize .

# Let Git detect text files and keep LF in the repository.
* text=auto

# Scripts that run on Linux (cluster, CI) must have LF in the working tree, also on Windows.
*.sh      text eol=lf
*.sbatch  text eol=lf
*.py      text eol=lf
*.R       text eol=lf
*.smk     text eol=lf
Snakefile text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.qmd     text eol=lf
*.md      text eol=lf
renv.lock text eol=lf
uv.lock   text eol=lf

# Never touch these.
*.png  binary
*.jpg  binary
*.pdf  binary
*.rds  binary
*.h5   binary

# Keep repository plumbing out of `git archive` (code deposits). Add tests/ or docs/ if wanted.
.gitattributes export-ignore
.gitignore     export-ignore
