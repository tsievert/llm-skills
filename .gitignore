*.log
*.tmp
*.bak
*~

# Python caches (for skill scripts)
__pycache__/
*.pyc
.venv/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Personal job-search inputs and state (never commit)
tmp-examples/
job-watch/
recipe-samples/

# Private, machine-local identity/context (name, email, ORCID, machine paths);
